{
    "layer": "top",
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "cpu", "memory", "network"],


    "hyprland/workspaces": {
	"format": "{name}"
    },


    "hyprland/window": {
    "format": "{}",
    "max-length": 60,
    "separate-outputs": true,
    "tooltip": false
    },


    "clock": {
        "format": " {:%I:%M %p}",
        "format-alt": "󰃰 {:%A, %B %d, %Y (%I:%M %p)}",
        "interval": 60,
        "tooltip": false
    },

    "tray": {
    "icon-size": 21,
    "spacing": 10
    },

    "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 Muted",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "scroll-step": 5,
    "tooltip": false
    },


    "cpu": {
    "format": " {usage}%",
    "interval": 1,
    "tooltip": false
    },


    "memory": {
    "format": " {percentage}%",
    "interval": 15,
    "tooltip": false
    },


    "network": {
    "format-ethernet": "󰈀 Ethernet",
    "format-disconnected": "󰖪",
    "interval": 3,
    "tooltip": false
    }
}
